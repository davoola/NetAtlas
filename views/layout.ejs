<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <script>
    (function(){try{var t=localStorage.getItem("theme")||localStorage.getItem("netatlas-theme");if(t!=="dark"&&t!=="light"){t=window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"}document.documentElement.setAttribute("data-theme",t);document.documentElement.style.colorScheme=t;try{localStorage.setItem("theme",t)}catch(e){}}catch(e){document.documentElement.setAttribute("data-theme","light")}})();
  </script>
  <style id="theme-fouc">
    html,body{background-color:#f3f6f9;color:#0f172a}
    html[data-theme="dark"],html[data-theme="dark"] body{background-color:#0b131d;color:#e8eef6}
  </style>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
  <% if (typeof user !== 'undefined' && user) { %><meta name="user-role" content="<%= user.role %>">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <% if (user.mustChangePassword) { %><meta name="must-change-password" content="1"><% } %><% } %>
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %><%= siteName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme-toggle.js"></script>
</head>
<body>
  <div class="app-container">
    <%- include('partials/sidebar') %>
    <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>
    <div class="main-content" id="mainContent">
      <%- include('partials/header') %>
      <main class="page-content">
        <%- body %>
      </main>
      <footer class="site-footer">
        <span class="footer-left">© NetAtlas 网图 · IP 管家</span>
        <span class="footer-right">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          网络资源管理平台
        </span>
      </footer>
    </div>
  </div>
  <div class="toast-container" id="toastContainer"></div>
  <script src="/js/app.js"></script>
  <% if (typeof extraScript !== 'undefined' && extraScript) { %><script src="<%= extraScript %>"></script><% } %>
</body>
</html>
