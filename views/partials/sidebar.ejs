<% if (typeof user !== 'undefined' && user) { %>
<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <a class="brand-mark" href="/dashboard" aria-label="NetAtlas 网图首页">
      <img src="/logo/logo.png" alt="NetAtlas 网图" class="brand-logo">
      <div class="brand-text">
        <span class="brand-name">NetAtlas 网图</span>
        <span class="brand-sub">IP Manager · IP 管家</span>
      </div>
    </a>
    <button class="sidebar-collapse" id="sidebarCollapse" type="button" aria-label="收起侧边栏" title="收起侧边栏">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/><path d="M19 6v12"/></svg>
    </button>
  </div>
  <div class="sidebar-section-label">工作空间 / WORKSPACE</div>
  <nav class="sidebar-nav">
    <a href="/dashboard" class="<%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      <span>仪表板</span>
    </a>
    <a href="/records" class="<%= typeof activePage !== 'undefined' && activePage === 'records' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
      <span>IP登记台账</span>
    </a>
    <a href="/subnets" class="<%= typeof activePage !== 'undefined' && activePage === 'subnets' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      <span>网段明细</span>
    </a>
    <a href="/dictionary" class="<%= typeof activePage !== 'undefined' && activePage === 'dictionary' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <span>数据字典</span>
    </a>
    <% if (user.role === 'superadmin') { %>
    <a href="/users" class="<%= typeof activePage !== 'undefined' && activePage === 'users' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span>用户管理</span>
    </a>
    <a href="/audit-log" class="<%= typeof activePage !== 'undefined' && activePage === 'audit-log' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
      <span>审计日志</span>
    </a>
    <a href="/import" class="<%= typeof activePage !== 'undefined' && activePage === 'import' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      <span>数据导入</span>
    </a>
    <% } %>
  </nav>
  <div class="sidebar-footer">
    <div class="network-status-card">
      <div class="network-status-header">
        <span class="network-status-title">网络运行状态</span>
        <span class="network-status-badge">正常</span>
      </div>
      <div class="network-status-meta">
        <span class="network-status-count" id="sidebarVlanCount">05</span>
        <span class="network-status-unit">/ VLANs</span>
      </div>
      <div class="network-status-chart" aria-hidden="true">
        <span style="height:40%"></span><span style="height:65%"></span><span style="height:45%"></span>
        <span style="height:80%"></span><span style="height:55%"></span><span style="height:70%"></span>
        <span style="height:50%"></span><span style="height:90%"></span><span style="height:60%"></span>
        <span style="height:75%"></span><span style="height:40%"></span><span style="height:85%"></span>
      </div>
    </div>
    <div class="sidebar-brand-meta">
      <img src="/logo/logo.png" alt="" class="sidebar-brand-meta-logo" width="16" height="16">
      <span>NetAtlas / v2.4.0</span>
    </div>
  </div>
</aside>
<% } %>
