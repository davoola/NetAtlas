<div class="dashboard-page">
  <h2 class="page-title">仪表板与统计</h2>

  <div class="kpi-grid kpi-grid-two-rows" id="kpiGrid">
    <div class="kpi-card"><div class="kpi-label">登记总数</div><div class="kpi-value" id="kpi-total">-</div></div>
    <div class="kpi-card kpi-green"><div class="kpi-label">已使用</div><div class="kpi-value" id="kpi-used">-</div></div>
    <div class="kpi-card"><div class="kpi-label">有MAC记录</div><div class="kpi-value" id="kpi-mac">-</div></div>
    <div class="kpi-card kpi-blue"><div class="kpi-label">使用中VLAN数</div><div class="kpi-value" id="kpi-activeVlan">-</div></div>
    <div class="kpi-card kpi-yellow"><div class="kpi-label">预留/备用</div><div class="kpi-value" id="kpi-reserved">-</div></div>
    <div class="kpi-card kpi-red"><div class="kpi-label">已废弃</div><div class="kpi-value" id="kpi-deprecated">-</div></div>
    <div class="kpi-card"><div class="kpi-label">有向日葵ID</div><div class="kpi-value" id="kpi-sunlogin">-</div></div>
    <div class="kpi-card kpi-red"><div class="kpi-label">重复IP数</div><div class="kpi-value" id="kpi-dup">-</div></div>
    <div class="kpi-card kpi-yellow"><div class="kpi-label">IP-MAC冲突</div><div class="kpi-value" id="kpi-macConflict">-</div></div>
  </div>

  <div class="dashboard-sections">
    <div class="dashboard-section">
      <h3 class="section-title">VLAN / 网段统计</h3>
      <div class="table-wrap">
        <table class="data-table" id="vlanStatsTable">
          <thead>
            <tr>
              <th>VLAN</th>
              <th>网段/名称</th>
              <th>子网掩码</th>
              <th>网关</th>
              <th>已用</th>
              <th>容量</th>
              <th>利用率</th>
              <th>说明</th>
              <th>可用地址参考</th>
            </tr>
          </thead>
          <tbody id="vlanStatsBody"></tbody>
        </table>
      </div>
    </div>

    <div class="dashboard-row">
      <div class="dashboard-section half">
        <h3 class="section-title">按部门统计</h3>
        <div class="stat-list" id="deptStats"></div>
      </div>
      <div class="dashboard-section half">
        <h3 class="section-title">按设备类型统计</h3>
        <div class="stat-list" id="deviceStats"></div>
      </div>
    </div>
  </div>
</div>
