# ============================================================
# NetAtlas 环境变量示例
# 使用方法：cp .env.example .env ，然后按需编辑。
# .env 含敏感信息，不要提交到版本库（已在 .gitignore 中忽略）。
# ============================================================

# 【生产环境必填】Session 签名密钥，至少 32 个字符。
# 生成方法：openssl rand -hex 32
# NODE_ENV=production 时缺失或少于 32 字符，服务将拒绝启动。
SESSION_SECRET=

# 运行环境：development（默认）或 production。
# production 下 Cookie 启用 Secure（需通过 HTTPS 访问）、启用 HSTS。
NODE_ENV=development

# 监听端口
PORT=3000

# 【可选】初始超级管理员 admin 的密码，仅在执行 npm run init-db 且用户表为空时使用。
# 规则：8–128 位，且不能是 admin123 等已知弱口令；不满足则 init-db 失败。
# 留空：init-db 会生成随机一次性密码，仅在终端显示一次，首次登录强制修改。
# 设置：使用该密码登录，不强制改密（建议初始化完成后从 .env 中删除此项）。
ADMIN_INITIAL_PASSWORD=

# 【仅在反向代理之后按需开启】代理层数（如 1）。
# 未部署在反向代理后请不要设置，否则客户端 IP 可被伪造。
# TRUST_PROXY=1

# 【可选】SQLite 数据库路径，默认 db/ipam.db
# DB_PATH=

# 【可选】导入/导出资源上限
# IMPORT_MAX_ROWS=20000
# IMPORT_MAX_COLS=60
# IMPORT_MAX_CELL_CHARS=2000
# IMPORT_PARSE_TIMEOUT_MS=30000
# EXPORT_MAX_ROWS=200000

# 【可选】设为 0 关闭结构化访问日志
# ACCESS_LOG=1
